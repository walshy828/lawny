# ── Database ──────────────────────────────────────
# Use 'db' for the local container, or point to your external server
DB_HOST=db
DB_PORT=5432
DB_USER=lawny
DB_PASSWORD=change_me_please
DB_NAME=lawny

# ── Application ───────────────────────────────────
APP_PORT=8080
TZ=America/New_York

# Optional PIN for app access (leave empty to disable)
APP_PIN=

# ── AI Providers (at least one required for AI features) ──────────────
# OpenAI — GPT-4o Vision (best for photo diagnosis)
OPENAI_API_KEY=

# Anthropic Claude — claude-sonnet-4-6 (excellent for consultation Q&A)
ANTHROPIC_API_KEY=

# Google Gemini — gemini-2.0-flash (fast, cost-effective)
GEMINI_API_KEY=

# ── MapTiler (optional — enhanced satellite tiles) ─
# Free tier: 100k tiles/month. Falls back to Esri satellite tiles if not set.
MAPTILER_KEY=
